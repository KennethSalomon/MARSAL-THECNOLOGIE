{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/solutions", "destination": "/solutions.html" },
    { "source": "/catalogue", "destination": "/catalogue.html" },
    { "source": "/temoignages", "destination": "/temoignages.html" }
  ]
}
